{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/swayam404/swayam404-knowledge/main/schema/manifest.schema.json",
  "title": "Swayam404 Knowledge Base Manifest",
  "description": "Root catalog manifest defining available courses, versions, content hashes, and pack paths.",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetVersion",
    "name",
    "publishedAt",
    "courses"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version of the manifest schema itself."
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the entire knowledge dataset."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Repository or dataset name."
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary of this knowledge repository."
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 publication timestamp."
    },
    "minExtensionVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum compatible Swayam404 extension version."
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "courseTitle",
          "language",
          "coursePackVersion",
          "lastUpdated",
          "metadataPath",
          "resourcesPath",
          "contentHash",
          "resourceCount",
          "reviewRecordCount"
        ],
        "additionalProperties": false,
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "description": "Stable unique course identifier."
          },
          "courseTitle": {
            "type": "string",
            "minLength": 1,
            "description": "Full display title of the course."
          },
          "provider": {
            "type": "string",
            "description": "Course hosting provider (e.g. NPTEL / SWAYAM)."
          },
          "institution": {
            "type": "string",
            "description": "Offering academic institution (e.g. IIT Madras)."
          },
          "language": {
            "type": "string",
            "default": "en",
            "description": "Primary course language code (ISO 639-1)."
          },
          "coursePackVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version of this course's specific pack."
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of last modification."
          },
          "metadataPath": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-\\./]+$",
            "description": "Relative repository path to course.json."
          },
          "resourcesPath": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-\\./]+$",
            "description": "Relative repository path to resources.json."
          },
          "reviewRecordsPath": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-\\./]+$",
            "description": "Optional relative repository path to review-records.json."
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 integrity hash of the pack."
          },
          "resourceCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Total learning resources in this pack."
          },
          "reviewRecordCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Total post-assessment review records in this pack."
          }
        }
      }
    }
  }
}
