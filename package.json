{
  "name": "swayam404",
  "version": "1.2.0",
  "description": "SWAYAM Assignment Assistant Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "verify:version": "node scripts/verify-versions.mjs",
    "build": "node scripts/verify-versions.mjs && tsc --noEmit && node scripts/build.js",
    "package:zip": "node scripts/package-zip.mjs",
    "release:local": "node scripts/generate-local-release.mjs",
    "server:local": "node local-update-server/server.mjs",
    "update:apply": "node scripts/apply-local-update.mjs",
    "update:rollback": "node scripts/apply-local-update.mjs --rollback",
    "installer": "node installer-app/server.mjs",
    "installer:open": "node installer-app/server.mjs --open",
    "admin": "node admin-panel/server.mjs",
    "admin:open": "node admin-panel/server.mjs --open",
    "package:installer": "node scripts/bundle-installer.mjs",
    "app": "electron installer-app/electron-main.cjs",
    "test:updater": "vitest run src/test/local-updater.test.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.7.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
