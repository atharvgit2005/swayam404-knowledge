{
  "manifest_version": 3,
  "name": "swayam404 — SWAYAM Assignment Assistant",
  "version": "1.2.0",
  "description": "Smart, student-controlled assignment assistant for SWAYAM courses. Review, verify, and populate approved answers with zero auto-submission.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.swayam2.ac.in/*",
    "https://swayam2.ac.in/*",
    "https://*.swayam.gov.in/*",
    "https://swayam.gov.in/*",
    "https://*.nptel.ac.in/*",
    "https://nptel.ac.in/*",
    "https://*.chatgpt.com/*",
    "https://chatgpt.com/*",
    "https://*.claude.ai/*",
    "https://claude.ai/*",
    "https://*.gemini.google.com/*",
    "https://gemini.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "swayam404 Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.swayam2.ac.in/*",
        "https://swayam2.ac.in/*",
        "https://*.swayam.gov.in/*",
        "https://swayam.gov.in/*",
        "https://*.nptel.ac.in/*",
        "https://nptel.ac.in/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.chatgpt.com/*",
        "https://chatgpt.com/*",
        "https://*.claude.ai/*",
        "https://claude.ai/*",
        "https://*.gemini.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["chatgptContent.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
